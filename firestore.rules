rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // แอดมิน = อีเมล Google ที่อยู่ในรายการนี้ (ต้องตรงกับ OCHE_ADMINS ใน config.js)
    // อีเมลแอดมินอยู่ในไฟล์นี้เท่านั้น (ไม่เปิดเผยบนหน้าเว็บ)
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['ADMIN_EMAIL'];
    }
    function isAdmin() {
      return isOwnerEmail() || (signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin');
    }
    function isStaff() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['referee', 'admin']);
    }
    // ทุกคนดูข้อมูลได้ (สกอร์สด อันดับ ผังการแข่งขัน)
    match /league/settings { allow read: if true; allow write: if isAdmin(); }
    match /league/tours    { allow read: if true; allow write: if signedIn(); }
    match /league/audit    { allow read: if true; allow write: if isStaff(); }
    match /teams/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /roles/{uid}     { allow read: if true; allow write: if isAdmin(); }
    match /rooms/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.json is string;
      allow delete: if isStaff();
    }
    match /players/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      // ผู้เล่นสร้างโปรไฟล์ของตัวเองได้ (บทบาท player เท่านั้น)
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'player');
      // ผู้เล่นแก้โปรไฟล์ตัวเอง / เปลี่ยนทีม / เชื่อมชื่อที่แอดมินเพิ่มไว้ (เปลี่ยนบทบาทเองไม่ได้)
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == resource.data.get('role', 'player')
        && (resource.data.get('uid', null) == request.auth.uid || resource.data.get('uid', null) == null));
    }
  }
}
